# Which exchange connection is active. Only one exchange is used at a
# time (docs/BUSINESS_RULES.md §9). Supported values: binance, bybit,
# okx, kraken, mexc.
EXCHANGE=binance
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# When true, uses each exchange's sandbox/testnet endpoint if ccxt
# supports one for that exchange (Binance, Bybit and OKX do; Kraken and
# MEXC do not and will log a warning and fall back to the live public
# endpoint for market data).
EXCHANGE_TESTNET=true
