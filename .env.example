# Sprint 18 -- simultaneous multi-exchange.
# Preferred: comma-separated list of venues to connect at once.
# Supported: binance, bybit, okx, kraken, mexc
EXCHANGES=binance
# Optional shared default; per-venue BINANCE_TESTNET etc. override this.
EXCHANGE_TESTNET=true

# Per-venue credentials (prefix = uppercase exchange name).
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# BYBIT_API_KEY=
# BYBIT_API_SECRET=
# BYBIT_TESTNET=true

# OKX_API_KEY=
# OKX_API_SECRET=
# OKX_PASSPHRASE=
# OKX_TESTNET=true

# ---------------------------------------------------------------------------
# Legacy single-exchange (still supported when EXCHANGES is unset/empty):
# EXCHANGE=binance
# EXCHANGE_API_KEY=
# EXCHANGE_API_SECRET=
# EXCHANGE_PASSPHRASE=
# EXCHANGE_TESTNET=true
# ---------------------------------------------------------------------------

# Sprint 11 -- Telegram Bot API notifications (optional).
# When both token and chat_id are set, alerts are enabled automatically
# unless TELEGRAM_ENABLED=false.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_ENABLED=true
# TELEGRAM_DAILY_SUMMARY_HOUR=0
# TELEGRAM_WEEKLY_SUMMARY_WEEKDAY=0
# TELEGRAM_CONNECTIVITY_PROBE_SECONDS=60

# Sprint 13 -- database backend (SQLite default; Postgres / MariaDB optional).
# Precedence: DATABASE_URL env > config.json "database" > DB_BACKEND/DB_* env > sqlite default.
# See config.example.json for the config.json shape.
# Option A: full SQLAlchemy URL (always wins when set)
# DATABASE_URL=sqlite:///csb_spot_bot.db
# DATABASE_URL=postgresql+psycopg://csb:secret@localhost:5432/csb_spot_bot
# DATABASE_URL=mysql+pymysql://csb:secret@localhost:3306/csb_spot_bot
#
# Option B: discrete fields
# DB_BACKEND=sqlite
# DB_PATH=csb_spot_bot.db
# DB_BACKEND=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=csb_spot_bot
# DB_USER=csb
# DB_PASSWORD=
# DB_DRIVER=psycopg
# For MariaDB: DB_BACKEND=mariadb  DB_PORT=3306  DB_DRIVER=pymysql
# Drivers: pip install -r requirements-db.txt
# Optional path override for config.json:
# CONFIG_JSON_PATH=./config.json

# Paper trading -- real WS/REST prices, local simulated wallet/orders.
# TRADE_MODE=paper
# PAPER_TRADING=true
# PAPER_INITIAL_BALANCE=10000

# Multi-strategy (comma-separated). Default: dip_hunter alone.
# STRATEGIES=dip_hunter,momentum,breakout,scalper
# STRATEGY_BUDGET_DIP_HUNTER=10000
# STRATEGY_BUDGET_MOMENTUM=10000
# STRATEGY_BUDGET_BREAKOUT=10000
# STRATEGY_BUDGET_SCALPER=5000
